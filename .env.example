# Copia este archivo a ".env" (sin ".example") para correr localmente. En
# Render estas mismas variables se cargan desde su panel ("Environment"), no
# desde este archivo -- nunca subas un ".env" real a un repo público.

SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
DATABASE_URL=postgresql+psycopg://usuario:password@host:puerto/nombre_basedatos?sslmode=require
