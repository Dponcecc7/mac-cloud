# Copia este archivo a ".env" (sin ".example") para correr localmente. En
# Render estas mismas variables se cargan desde su panel ("Environment"), no
# desde este archivo -- nunca subas un ".env" real a un repo público.

# --- App Flask / sesiones ---
SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
SESSION_COOKIE_SECURE=true
CRON_TRIGGER_TOKEN=token-para-proteger-/cron/pipeline-y-/cron/exportar

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://usuario:password@host:puerto/nombre_basedatos?sslmode=require

# --- Athena/AWS (pipeline/athena_client.py -- trae visitas desde livetradebi) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ATHENA_S3_STAGING=s3://bucket/ruta-de-staging/
AWS_REGION=us-east-1

# --- Microsoft Graph / SharePoint (graph_client.py -- lee/sube los Excel de dimensiones) ---
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# --- GitHub Actions (github_actions.py -- dispara el pipeline desde la app, ej. "Dar de baja") ---
# Personal Access Token fine-grained, scope solo el repo mac-cloud, permiso "Actions: write"
GITHUB_PAT=

# --- Opcional, tiene default razonable (10 días) ---
VENTANA_DIAS_VISITAS=10
